{
  "version": "1.0.0",
  "note": "Controlled target vocabulary for canonical outcomes (the ontology evidence is normalised into). Rules are applied in order; the first matching pattern wins. Patterns match the outcome's clinical phrase after reporting wording is removed.",
  "outcomes": [
    {"variable": "pathological_complete_response", "domain": "response", "value_type": "binary", "direction": "higher_better",
     "patterns": ["patholog\\w* complete (?:response|remission)", "\\bpcr\\b"]},
    {"variable": "complete_response", "domain": "response", "value_type": "binary", "direction": "higher_better",
     "patterns": ["^(?:best )?(?:overall )?complete (?:response|remission)", "complete (?:response|remission)(?: rate)?$", "\\bcr rate\\b"]},
    {"variable": "partial_response", "domain": "response", "value_type": "binary", "direction": "higher_better",
     "patterns": ["^partial response", "partial response(?: rate)?$"]},
    {"variable": "disease_control_rate", "domain": "response", "value_type": "binary", "direction": "higher_better",
     "patterns": ["disease control", "\\bdcr\\b"]},
    {"variable": "clinical_benefit_rate", "domain": "response", "value_type": "binary", "direction": "higher_better",
     "patterns": ["clinical benefit"]},
    {"variable": "duration_of_response", "domain": "response", "value_type": "time_to_event", "preferred_unit": "month", "direction": "higher_better",
     "patterns": ["duration of (?:\\w+ )?(?:response|remission)", "\\bdo[rr]\\b", "response duration"]},
    {"variable": "time_to_response", "domain": "response", "value_type": "time_to_event", "preferred_unit": "month", "direction": "lower_better",
     "patterns": ["time to (?:\\w+ )?response", "\\bttr\\b"]},
    {"variable": "objective_response_rate", "domain": "response", "value_type": "binary", "direction": "higher_better",
     "patterns": ["objective (?:tumou?r )?response", "overall (?:tumou?r )?response", "\\borr\\b", "best (?:overall )?(?:tumou?r )?response", "^(?:tumou?r |clinical |radiologic\\w* |objective )?response(?: rate)?(?: to (?:study )?treatment)?$", "^responders?$", "^tumou?r response"]},
    {"variable": "tumor_size_change", "domain": "response", "value_type": "continuous", "direction": "lower_better",
     "patterns": ["change in (?:\\w+ )?(?:tumou?r|lesion) (?:size|burden|diameter)", "(?:tumou?r|target lesion) (?:shrinkage|size change)"]},
    {"variable": "progression_free_survival", "domain": "survival", "value_type": "time_to_event", "preferred_unit": "month", "direction": "higher_better",
     "patterns": ["progression[- ]free survival", "\\bpfs\\b", "progression[- ]free rate"]},
    {"variable": "event_free_survival", "domain": "survival", "value_type": "time_to_event", "preferred_unit": "month", "direction": "higher_better",
     "patterns": ["event[- ]free survival", "\\befs\\b"]},
    {"variable": "disease_free_survival", "domain": "survival", "value_type": "time_to_event", "preferred_unit": "month", "direction": "higher_better",
     "patterns": ["disease[- ]free survival", "\\bdfs\\b"]},
    {"variable": "relapse_free_survival", "domain": "survival", "value_type": "time_to_event", "preferred_unit": "month", "direction": "higher_better",
     "patterns": ["relapse[- ]free survival", "recurrence[- ]free survival", "\\brfs\\b"]},
    {"variable": "failure_free_survival", "domain": "survival", "value_type": "time_to_event", "preferred_unit": "month", "direction": "higher_better",
     "patterns": ["failure[- ]free survival", "\\bffs\\b"]},
    {"variable": "metastasis_free_survival", "domain": "survival", "value_type": "time_to_event", "preferred_unit": "month", "direction": "higher_better",
     "patterns": ["metastas\\w*[- ]free survival", "\\bmfs\\b"]},
    {"variable": "overall_survival", "domain": "survival", "value_type": "time_to_event", "preferred_unit": "month", "direction": "higher_better",
     "patterns": ["overall survival", "\\bos\\b", "^survival(?: rate| time)?$", "^(?:median )?survival$", "^participants surviving$"]},
    {"variable": "time_to_progression", "domain": "progression", "value_type": "time_to_event", "preferred_unit": "month", "direction": "higher_better",
     "patterns": ["time to (?:\\w+ )?progression", "\\bttp\\b"]},
    {"variable": "time_to_treatment_failure", "domain": "progression", "value_type": "time_to_event", "preferred_unit": "month", "direction": "higher_better",
     "patterns": ["time to (?:treatment )?failure", "\\bttf\\b"]},
    {"variable": "disease_progression", "domain": "progression", "value_type": "binary", "direction": "lower_better",
     "patterns": ["^(?:disease )?progression(?: rate)?$", "progressive disease"]},
    {"variable": "psa_response", "domain": "biomarker", "value_type": "binary", "direction": "higher_better",
     "patterns": ["\\bpsa\\b.*(?:response|decline|decrease|reduction)", "prostate[- ]specific antigen.*(?:response|decline|decrease|reduction)"]},
    {"variable": "psa_level", "domain": "biomarker", "value_type": "continuous",
     "patterns": ["\\bpsa\\b", "prostate[- ]specific antigen"]},
    {"variable": "testosterone_level", "domain": "biomarker", "value_type": "continuous",
     "patterns": ["testosterone"]},
    {"variable": "quality_of_life", "domain": "patient_reported", "value_type": "continuous",
     "patterns": ["quality of life", "\\bqol\\b", "\\beortc\\b", "\\bfact-", "\\bpro\\b"]}
  ],
  "disposition": [
    {"category": "death", "patterns": ["death", "died"]},
    {"category": "adverse_event", "patterns": ["adverse event", "toxicit", "side effect"]},
    {"category": "progression", "patterns": ["progress", "relapse", "lack of efficacy", "treatment failure"]},
    {"category": "withdrawal", "patterns": ["withdraw", "consent", "refus"]},
    {"category": "lost_to_follow_up", "patterns": ["lost to follow"]},
    {"category": "physician_decision", "patterns": ["physician", "investigator"]},
    {"category": "protocol_violation", "patterns": ["protocol (?:violation|deviation)", "ineligib", "not eligible"]},
    {"category": "completed", "patterns": ["complet"]},
    {"category": "ongoing", "patterns": ["ongoing", "still on", "continuing"]},
    {"category": "other", "patterns": [".*"]}
  ],
  "response_categories": [
    {"category": "complete_response", "patterns": ["complete (?:response|remission)", "\\bcr\\b"]},
    {"category": "partial_response", "patterns": ["partial (?:response|remission)", "\\bpr\\b"]},
    {"category": "stable_disease", "patterns": ["stable disease", "\\bsd\\b"]},
    {"category": "progressive_disease", "patterns": ["progressive disease", "progression", "\\bpd\\b"]},
    {"category": "not_evaluable", "patterns": ["not evaluable", "unknown", "not assessed", "missing", "\\bne\\b"]}
  ]
}
